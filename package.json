  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:build": "NEXT_PUBLIC_DEMO_MODE=true NEXT_DIST_DIR=.next-demo next build",
