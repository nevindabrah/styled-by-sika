    "test:e2e": "playwright test",
    "db:seed": "node --experimental-strip-types scripts/supabase-seed.mjs",
    "check:launch": "node --experimental-strip-types scripts/check-launch.mjs",
    "test:unit": "vitest run"
  },
  "dependencies": {
