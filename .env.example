# ── Copy to .env.local. Never commit .env.local. ─────────────────────────────

# REQUIRED · Supabase (Project Settings → API, and → Database → Connection string → URI)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# REQUIRED · Sika's sign-in email (create it with: npm run admin:create -- email password)
ADMIN_EMAIL=

# REQUIRED for live booking · Resend (resend.com → API Keys; verify the sending domain first)
RESEND_API_KEY=
FROM_EMAIL=Styled by Sika <bookings@yourdomain.com>
BRAIDER_EMAIL=styledbysika@gmail.com

# REQUIRED for live booking · password for the reminder/retry scheduler (any long random string; then run npm run cron:setup)
CRON_SECRET=

# REQUIRED · the public https address once deployed (Vercel gives you one)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BUSINESS_TIMEZONE=America/Toronto

# Switch on only after `npm run check:launch` passes and Sika has saved her hours
BOOKING_ENABLED=false
# Keep false for the client-facing site. Demo scripts set this explicitly.
NEXT_PUBLIC_DEMO_MODE=false

# OPTIONAL · Google Calendar sync (all three or none)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
# OPTIONAL · Upstash rate limiting (both or neither); in-memory limits are used otherwise
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# OPTIONAL · text messages via Twilio (all three or none). TWILIO_FROM is your Twilio number (+1…) or a Messaging Service SID (MG…)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# OPTIONAL · who gets alerted if an email or calendar update keeps failing
MAINTAINER_EMAIL=
